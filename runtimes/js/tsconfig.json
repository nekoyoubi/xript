{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"paths": {
			"#quickjs-sync": ["./src/quickjs-sync.ts"],
			"#quickjs-async": ["./src/quickjs-async.ts"]
		}
	},
	"include": ["src/**/*"]
}
