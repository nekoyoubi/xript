{
  "description": "Conformance corpus for declared execution intent. Every runtime and every tool that resolves or widens an `execution` block asserts against this file. It carries the canonical `executionIntent` schema block so the copies in manifest.schema.json and mod-manifest.schema.json cannot drift apart, the defaulting and inheritance rules, the widen lattice, the host-versus-mod precedence rules, and the lint expectations.",
  "notes": [
    "Intent is advisory. It is not `limits` (enforcement) and it is not a capability (no grant is consulted).",
    "`duration` is totally ordered instant < brief < long < unbounded. `affinity` is totally ordered any < pinned < isolated.",
    "A surface resolves to its own `execution`, else its manifest's top-level `execution`, else the schema defaults.",
    "The schema block is duplicated across the two schema files rather than `$ref`'d across them, so that offline mod validation never depends on host-schema resolution. This corpus is what keeps the copies identical.",
    "`limits` is declarable on a hook and on a slot, never on a binding: a binding is host code, and once control is inside it no xript timeout reaches it. `execution-long-no-limits` therefore applies to slots and hooks, and a long binding gets `execution-long-binding-blocks` instead, which asks the host to route the call rather than to widen a budget it cannot declare."
  ],
  "schemaBlock": {
    "description": "How a host should expect this surface to behave in time and where it may run. Advisory routing signal — never enforced, never a capability. Enforcement lives in `limits`.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "duration": {
        "type": "string",
        "enum": [
          "instant",
          "brief",
          "long",
          "unbounded"
        ],
        "default": "brief",
        "description": "How long a host should expect this to take."
      },
      "affinity": {
        "type": "string",
        "enum": [
          "any",
          "pinned",
          "isolated"
        ],
        "default": "any",
        "description": "Where this may run. `any` is poolable. `pinned` must run on the runtime that owns the calling mod's state. `isolated` wants a runtime nobody else is using."
      }
    }
  },
  "defaults": {
    "duration": "brief",
    "affinity": "any"
  },
  "durationOrder": [
    "instant",
    "brief",
    "long",
    "unbounded"
  ],
  "affinityOrder": [
    "any",
    "pinned",
    "isolated"
  ],
  "widen": [
    {
      "name": "two silent sides fall to the defaults",
      "a": {},
      "b": {},
      "expected": {
        "duration": "brief",
        "affinity": "any"
      }
    },
    {
      "name": "the more expensive duration wins",
      "a": {
        "duration": "brief"
      },
      "b": {
        "duration": "long"
      },
      "expected": {
        "duration": "long",
        "affinity": "any"
      }
    },
    {
      "name": "widen is symmetric",
      "a": {
        "duration": "long"
      },
      "b": {
        "duration": "brief"
      },
      "expected": {
        "duration": "long",
        "affinity": "any"
      }
    },
    {
      "name": "neither party can weaken the other",
      "a": {
        "duration": "unbounded",
        "affinity": "isolated"
      },
      "b": {
        "duration": "instant",
        "affinity": "any"
      },
      "expected": {
        "duration": "unbounded",
        "affinity": "isolated"
      }
    },
    {
      "name": "the axes widen independently",
      "a": {
        "duration": "long",
        "affinity": "any"
      },
      "b": {
        "duration": "instant",
        "affinity": "pinned"
      },
      "expected": {
        "duration": "long",
        "affinity": "pinned"
      }
    },
    {
      "name": "an explicit instant still loses to the other side's default",
      "a": {
        "duration": "instant"
      },
      "b": {},
      "expected": {
        "duration": "brief",
        "affinity": "any"
      }
    }
  ],
