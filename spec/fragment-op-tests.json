  {
    "description": "replaceChildren over a tree vocabulary runs the node list through the vocabulary",
    "format": "application/x-ratatui+json",
    "formats": {
      "application/x-ratatui+json": {
        "syntax": "jsml",
        "nodes": {
          "Block": {
            "props": {
              "title": {
                "type": "string"
              },
              "link": {
                "type": "string",
                "sink": "uri"
              }
            },
            "children": "any"
          },
          "Gauge": {
            "props": {
              "ratio": {
                "type": "number"
              },
              "style": {
                "type": "string",
                "sink": "css"
              }
            },
            "children": "none",
            "bindTo": "ratio"
          }
        }
      }
    },
    "ops": [
      {
        "op": "replaceChildren",
        "selector": "#b",
        "value": [
          [
            "Gauge",
            {
              "ratio": 0.5,
              "bogus": 1
            }
          ],
          [
            "Nope"
          ]
        ]
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "replaceChildren",
          "selector": "#b",
          "target": {
            "by": "id",
            "id": "b"
          },
          "value": [
            [
              "Gauge",
              {
                "ratio": 0.5
              }
            ]
          ]
        }
      ],
      "diagnostics": []
    }
  },
