[
  {
    "description": "built-in html sanitizes a setAttr href",
    "format": "text/html",
    "ops": [
      {
        "op": "setAttr",
        "selector": "#a",
        "attr": "href",
        "value": "javascript:alert(1)"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "unsafe-prop",
          "severity": "warning",
          "node": "#a",
          "prop": "href",
          "message": "prop \"href\" was rejected by its sink",
          "path": "/0"
        }
      ]
    }
  },
  {
    "description": "built-in html allows a safe setAttr href",
    "format": "text/html",
    "ops": [
      {
        "op": "setAttr",
        "selector": "#a",
        "attr": "href",
        "value": "/docs"
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "setAttr",
          "selector": "#a",
          "target": {
            "by": "id",
            "id": "a"
          },
          "prop": "href",
          "attr": "href",
          "value": "/docs"
        }
      ],
      "diagnostics": []
    }
  },
  {
    "description": "built-in html refuses an event-handler prop",
    "format": "text/html",
    "ops": [
      {
        "op": "setProp",
        "selector": ".x",
        "prop": "onclick",
        "value": "steal()"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "unsafe-prop",
          "severity": "warning",
          "node": ".x",
          "prop": "onclick",
          "message": "prop \"onclick\" is not settable on an HTML node",
          "path": "/0"
        }
      ]
    }
  },
  {
    "description": "built-in html sanitizes replaceChildren markup",
    "format": "text/html",
    "ops": [
      {
        "op": "replaceChildren",
        "selector": "#slot",
        "value": "<p onclick=\"x()\">hi</p><script>bad()</script>"
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "replaceChildren",
          "selector": "#slot",
          "target": {
            "by": "id",
            "id": "slot"
          },
          "value": "<p>hi</p>"
        }
      ],
      "diagnostics": [
        {
          "code": "unsafe-prop",
          "severity": "warning",
          "node": "p",
          "prop": "onclick",
          "message": "stripped attribute \"onclick\" on <p>",
          "path": "/0/0"
        },
        {
          "code": "stripped-node",
          "severity": "warning",
          "node": "script",
          "message": "stripped dangerous element: <script>",
          "path": "/0/1"
        }
      ]
    }
  },
