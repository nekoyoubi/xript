    "ops": [
      {
        "op": "setProp",
        "selector": ".x",
        "prop": "onclick",
        "value": "steal()"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "unsafe-prop",
          "severity": "warning",
          "node": ".x",
          "prop": "onclick",
          "message": "prop \"onclick\" is not settable on an HTML node",
          "path": "/0"
        }
      ]
    }
  },
  {
    "description": "built-in html sanitizes replaceChildren markup",
    "format": "text/html",
    "ops": [
      {
        "op": "replaceChildren",
        "selector": "#slot",
        "value": "<p onclick=\"x()\">hi</p><script>bad()</script>"
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "replaceChildren",
          "selector": "#slot",
          "target": {
            "by": "id",
            "id": "slot"
          },
          "value": "<p>hi</p>"
        }
      ],
      "diagnostics": []
    }
  },
  {
    "description": "built-in html keeps css selectors and sugar ops",
    "format": "text/html",
    "ops": [
      {
        "op": "addClass",
        "selector": ".card",
        "value": "active"
      },
      {
        "op": "toggle",
        "selector": "#a",
        "value": 1
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "addClass",
          "selector": ".card",
          "target": {
            "by": "selector",
            "selector": ".card"
          },
          "value": "active"
        },
        {
          "op": "toggle",
          "selector": "#a",
          "target": {
            "by": "id",
            "id": "a"
          },
          "value": false
        }
      ],
      "diagnostics": []
    }
  },
  {
    "description": "setText coerces a missing value to the empty string",
