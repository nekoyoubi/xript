          "code": "unsupported-op",
          "severity": "warning",
          "node": "#g",
          "message": "op \"addClass\" is HTML-vocabulary sugar and has no meaning in format \"application/x-ratatui+json\"",
          "path": "/0"
        }
      ]
    }
  },
