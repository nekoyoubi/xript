[
  {
    "description": "built-in html sanitizes a setAttr href",
    "format": "text/html",
    "ops": [
      {
        "op": "setAttr",
        "selector": "#a",
        "attr": "href",
        "value": "javascript:alert(1)"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "unsafe-prop",
          "severity": "warning",
          "node": "#a",
          "prop": "href",
          "message": "prop \"href\" was rejected by its sink",
          "path": "/0"
        }
      ]
    }
  },
  {
    "description": "built-in html allows a safe setAttr href",
    "format": "text/html",
    "ops": [
      {
        "op": "setAttr",
        "selector": "#a",
        "attr": "href",
        "value": "/docs"
      }
    ],
    "expected": {
      "ops": [
        {
          "op": "setAttr",
          "selector": "#a",
          "target": {
            "by": "id",
            "id": "a"
          },
          "prop": "href",
          "attr": "href",
          "value": "/docs"
        }
      ],
      "diagnostics": []
    }
  },
  {
    "description": "built-in html refuses an event-handler prop",
