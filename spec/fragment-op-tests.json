        "op": "setProp",
        "selector": "#n",
        "prop": "where",
        "value": "color:red"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "prop-sink-conflict",
          "severity": "warning",
          "node": "#n",
          "prop": "where",
          "message": "prop \"where\" is declared with conflicting sinks (css, uri) in format \"application/x-conflict+json\"",
          "path": "/0"
        }
      ]
    }
