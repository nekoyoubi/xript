  {
    "description": "conflicting sinks for one prop name are refused",
    "format": "application/x-conflict+json",
    "formats": {
      "application/x-conflict+json": {
        "syntax": "jsml",
        "nodes": {
          "Alpha": {
            "props": {
              "where": {
                "type": "string",
                "sink": "css"
              }
            }
          },
          "Beta": {
            "props": {
              "where": {
                "type": "string",
                "sink": "uri"
              }
            }
