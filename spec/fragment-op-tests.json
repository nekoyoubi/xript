  {
    "description": "a tree vocabulary refuses HTML sugar ops",
    "format": "application/x-ratatui+json",
    "formats": {
      "application/x-ratatui+json": {
        "syntax": "jsml",
        "nodes": {
          "Block": {
            "props": {
              "title": {
                "type": "string"
              },
              "link": {
                "type": "string",
                "sink": "uri"
              }
            },
            "children": "any"
          },
          "Gauge": {
            "props": {
              "ratio": {
                "type": "number"
              },
              "style": {
                "type": "string",
                "sink": "css"
              }
            },
            "children": "none",
            "bindTo": "ratio"
          }
        }
      }
    },
    "ops": [
      {
        "op": "addClass",
        "selector": "#g",
        "value": "on"
      }
    ],
    "expected": {
      "ops": [],
      "diagnostics": [
        {
          "code": "unsupported-op",
          "severity": "warning",
          "node": "#g",
          "message": "op \"addClass\" is HTML-vocabulary sugar and has no meaning in format \"application/x-ratatui+json\"",
          "path": "/0"
        }
      ]
    }
  },
