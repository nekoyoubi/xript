{
	"$schema": "https://xript.dev/schema/mod-manifest/v0.9.json",
	"xript": "0.9",
	"name": "inventory-panel",
	"version": "1.0.0",
	"title": "Inventory Panel",
	"description": "Shows the player's inventory as a keyed data-each list, with no script at all.",
	"author": "xript-examples",
	"fills": {
		"sidebar.left": [
			{
				"id": "inventory-list",
				"format": "text/html",
				"source": "fragments/inventory.html",
				"interpolate": true,
				"bindings": [
					{ "name": "playerName", "path": "player.name" },
					{ "name": "inventory", "path": "player.inventory" }
				],
				"priority": 5
			}
		]
	}
}
