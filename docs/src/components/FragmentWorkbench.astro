---
---

<div id="fwb">
	<div class="fwb-loading" id="fwb-loading">
		<div class="loading-spinner"></div>
		<p>Loading Fragment Workbench...</p>
	</div>
	<div class="fwb-main" id="fwb-main" style="display:none">
		<nav class="fwb-tabs" id="fwb-tabs">
			<button class="tab active" data-tab="manifest"><span class="tab-num">1</span> Manifest</button>
			<button class="tab" data-tab="author"><span class="tab-num">2</span> Author</button>
			<button class="tab" data-tab="preview"><span class="tab-num">3</span> Preview</button>
			<button class="tab" data-tab="export"><span class="tab-num">4</span> Export</button>
		</nav>

		<div class="tab-content active" id="tab-manifest">
			<div class="guide" id="guide-manifest">
				<button class="guide-toggle" data-guide="manifest">
					<span class="guide-arrow">&#9656;</span>
					<span class="guide-summary">Load the app manifest your mod will target</span>
				</button>
				<div class="guide-body" style="display:none">
					<p>Every xript mod targets a specific app manifest. The manifest declares the slots a mod can fill, the formats each slot accepts, the data a fragment can bind to, and the capabilities a fill needs.</p>
					<p><strong>Quick start:</strong> pick an example manifest below. <strong>Your own app:</strong> select "Custom" and paste your app's <code>manifest.json</code>, or generate one with <code>xript init --yes</code>. Every edit is checked by <code>@xriptjs/validate</code>: schema errors against the version the manifest targets, plus <code>xript lint</code> findings.</p>
				</div>
			</div>
			<div class="tab-panels">
				<div class="panel manifest-panel">
					<div class="panel-header">
						<h3>App Manifest</h3>
						<select id="fwb-manifest-select">
							<option value="dashboard">Dashboard App</option>
							<option value="game">Game HUD</option>
							<option value="custom">Custom...</option>
						</select>
					</div>
					<div class="code-editor" id="fwb-manifest-editor" spellcheck="false"></div>
					<div class="findings" id="fwb-manifest-findings"></div>
				</div>
				<div class="panel slot-panel">
					<div class="panel-header"><h3>Slot Contract</h3></div>
					<div class="slot-contract" id="fwb-slot-contract">
						<div class="placeholder">Click a slot in the preview to inspect its contract, or load a manifest to get started.</div>
					</div>
				</div>
			</div>
		</div>

		<div class="tab-content" id="tab-author">
			<div class="guide" id="guide-author">
				<button class="guide-toggle" data-guide="author">
					<span class="guide-arrow">&#9656;</span>
					<span class="guide-summary">Write your fragment in HTML or J5ML and bind it to host data</span>
				</button>
				<div class="guide-body" style="display:none">
					<p>Use <code>data-bind="key"</code> to display a value, <code>data-if="expr"</code> to show an element conditionally, <code>data-each="item in list"</code> to repeat an element per list entry, and <code>{"{{ expr }}"}</code> to interpolate into text. The real runtime renders every mount.</p>
					<p>As you type, the fragment is assembled into a mod manifest, cross-validated against the app manifest, and linted. The findings below the editor are the ones <code>xript validate --cross</code> and <code>xript lint</code> would print: unknown bindings, formats the slot does not accept, missing capabilities, and anything the sanitizer will strip.</p>
				</div>
			</div>
			<div class="tab-panels author-layout">
				<div class="panel editor-panel">
					<div class="panel-header">
						<h3>Fragment Source</h3>
						<span class="header-selects">
							<select id="fwb-format-toggle">
								<option value="html">HTML</option>
								<option value="j5ml">J5ML</option>
							</select>
							<select id="fwb-sample-select">
								<option value="">Sample...</option>
							</select>
						</span>
					</div>
					<div class="code-editor" id="fwb-editor" spellcheck="false"></div>
					<div class="findings" id="fwb-mod-findings"></div>
					<div class="editor-footer">
						<label class="slot-picker">
							<span>Slot:</span>
							<select id="fwb-slot-select"></select>
						</label>
						<button id="fwb-mount-btn" class="run-button">Mount</button>
					</div>
				</div>
				<div class="author-side">
					<div class="panel state-panel">
						<div class="panel-header"><h3>Host Data</h3></div>
						<div class="state-controls" id="fwb-state-controls">
							<div class="placeholder">Load a manifest to simulate host data.</div>
						</div>
					</div>
					<div class="panel console-panel">
						<div class="panel-header">
							<h3>Console</h3>
							<button id="fwb-clear-btn" class="clear-button">Clear</button>
						</div>
						<div class="fwb-console" id="fwb-console">
							<div class="placeholder">Mount a fragment to see output here.</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="tab-content" id="tab-preview">
			<div class="guide" id="guide-preview">
				<button class="guide-toggle" data-guide="preview">
					<span class="guide-arrow">&#9656;</span>
					<span class="guide-summary">See your fragments mounted in the host's slot layout</span>
				</button>
				<div class="guide-body" style="display:none">
					<p>This simulates how your fragment will appear inside the host application. Change the host data (Author tab) to test how your fragment responds. Click a slot to inspect its contract.</p>
				</div>
			</div>
			<div class="tab-panels preview-layout">
				<div class="panel host-panel">
					<div class="panel-header">
						<h3>Host Preview</h3>
						<button id="fwb-clear-slots-btn" class="clear-button">Clear Slots</button>
					</div>
					<div class="host-slots" id="fwb-host-slots">
						<div class="placeholder">Load a manifest to see the host's slot layout.</div>
					</div>
				</div>
				<div class="panel slot-panel-preview">
					<div class="panel-header"><h3>Slot Contract</h3></div>
					<div class="slot-contract" id="fwb-slot-contract-preview">
						<div class="placeholder">Click a slot to inspect it.</div>
					</div>
				</div>
			</div>
		</div>

		<div class="tab-content" id="tab-export">
			<div class="guide" id="guide-export">
				<button class="guide-toggle" data-guide="export">
					<span class="guide-arrow">&#9656;</span>
					<span class="guide-summary">Download your mod: a manifest plus its fragment source</span>
				</button>
				<div class="guide-body" style="display:none">
					<p>The workbench writes a <code>mod-manifest.json</code> that fills the slot you picked with your fragment, declares the bindings your expressions read, and requests the capability the slot requires. The zip holds the manifest and the fragment file it points at; tick <strong>Inline source</strong> to embed the fragment in the manifest instead.</p>
				</div>
			</div>
			<div class="tab-panels">
				<div class="panel export-panel">
					<div class="panel-header">
						<h3>Mod Manifest</h3>
						<span class="panel-actions">
							<button id="fwb-copy-manifest-btn" class="clear-button">Copy</button>
							<button id="fwb-export-btn" class="run-button">Download .zip</button>
						</span>
					</div>
					<div class="export-fields">
						<label>Name <input type="text" id="fwb-mod-name" value="my-mod" spellcheck="false" /></label>
						<label>Fill id <input type="text" id="fwb-fill-id" value="panel" spellcheck="false" /></label>
						<label class="export-check"><input type="checkbox" id="fwb-inline" /> Inline source</label>
					</div>
					<pre class="export-preview" id="fwb-export-preview"><span class="placeholder">Author a fragment and select a slot to see your mod manifest here.</span></pre>
					<div class="findings" id="fwb-export-status"></div>
					<div class="panel-header sub-header">
						<h3 id="fwb-fragment-path">Fragment</h3>
						<button id="fwb-copy-fragment-btn" class="clear-button">Copy</button>
					</div>
					<pre class="export-preview fragment-preview" id="fwb-fragment-preview"></pre>
				</div>
				<div class="panel export-info">
					<div class="panel-header"><h3>What's Next</h3></div>
					<div class="export-steps">
						<div class="export-step">
							<span class="step-num">1</span>
							<div>
								<strong>Download</strong> the zip and unpack it as your mod's folder
							</div>
						</div>
						<div class="export-step">
							<span class="step-num">2</span>
							<div>
								<strong>Validate</strong> the mod against the host app: <code>xript validate --cross app.json mod-manifest.json</code>
							</div>
						</div>
						<div class="export-step">
							<span class="step-num">3</span>
							<div>
								<strong>Lint</strong> the pair for the findings shown here: <code>xript lint app.json mod-manifest.json</code>
							</div>
						</div>
						<div class="export-step">
							<span class="step-num">4</span>
							<div>
								<strong>Add behavior</strong> with an entry script (<code>xript init --mod</code> scaffolds one) using the sandbox fragment API for dynamic updates
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import { htmlToTree, treeToJsml, treeToHtml, jsmlToTree, parseJsmlSource } from "@xriptjs/sanitize";
	import {
		validateManifestForVersion,
		crossValidate,
		lintManifests,
		fragmentReadNames,
		describeTargetVersion,
	} from "@xriptjs/validate/core";
	import { CodeJar } from "codejar";
	import { createLiveFragment } from "./fragment-dom";
	import { EXAMPLES, CUSTOM_MANIFEST } from "./workbench-examples";
	import {
		sampleHostData,
		bindingCatalog,
		dataLeaves,
		readPath,
		writePath,
		expressionType,
		buildModPackage,
	} from "./workbench-model";
	import { createZip } from "./zip";

	const J5ML = "application/j5ml+json";
	const HTML = "text/html";

	const escapeMarkup = (text) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
	const JSON_TOKEN = /("(?:[^"\\\n]|\\.)*")(\s*:)?|(-?\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b)|\b(true|false|null)\b/g;

	function highlightJSON(el) {
		const code = el.textContent || "";
		let html = "";
		let last = 0;
		for (const match of code.matchAll(JSON_TOKEN)) {
			html += escapeMarkup(code.slice(last, match.index));
			const [, string, colon, number, literal] = match;
			if (string !== undefined) {
				html += `<span class="${colon === undefined ? "hl-str" : "hl-key"}">${escapeMarkup(string)}</span>${colon ?? ""}`;
			} else if (number !== undefined) {
				html += `<span class="hl-num">${number}</span>`;
			} else {
				html += `<span class="hl-bool">${literal}</span>`;
			}
			last = match.index + match[0].length;
		}
		el.innerHTML = html + escapeMarkup(code.slice(last));
	}

	function highlightMarkup(el) {
		const code = el.textContent || "";
		el.innerHTML = code
			.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
			.replace(/&lt;(\/?)([\w-]+)((?:\s+[^&]*)?)&gt;/g, (_, slash, tag, attrs) => {
				const hlAttrs = attrs.replace(/([\w-]+)=&quot;([^&]*?)&quot;/g,
					'<span class="hl-attr">$1</span>=<span class="hl-str">&quot;$2&quot;</span>');
				return `&lt;<span class="hl-tag">${slash}${tag}</span>${hlAttrs}&gt;`;
			});
	}

	const $ = (id) => document.getElementById(id);
	const isObject = (value) => typeof value === "object" && value !== null && !Array.isArray(value);

	let manifestJar;
	let editorJar;
	let suppressManifestUpdate = false;
	let currentExample = "dashboard";
	let host = null;
	let hostShape = "";
	let hostData = {};
	let catalog = [];
	let hostLintKeys = new Set();
	let lastCross = null;
	let mounted = [];
	let hostRun = 0;
	let modRun = 0;

	function addConsole(text, level = "log") {
		const el = $("fwb-console");
		el.querySelector(".placeholder")?.remove();
		const line = document.createElement("div");
		line.className = `console-line ${level}`;
		const prefix = level === "log" ? "[log] " : level === "error" ? "[err] " : "=> ";
		line.textContent = `${prefix}${text}`;
		el.appendChild(line);
		el.scrollTop = el.scrollHeight;
	}

	function findingKey(finding) {
		return `${finding.code}\u0000${finding.message}`;
	}

	function schemaItems(result) {
		return [
			...result.errors.map((e) => ({ severity: "error", label: e.path, message: e.message, hint: e.keyword })),
			...(result.warnings ?? []).map((w) => ({ severity: "warn", label: w.path, message: w.message, hint: w.keyword })),
		];
	}

	function lintItems(findings) {
		return findings.map((f) => ({ severity: f.severity, label: f.code, message: f.message, hint: f.suggestion }));
	}

	function renderFindings(el, headline, ok, items) {
		el.replaceChildren();
		const head = document.createElement("div");
		head.className = `findings-head ${ok ? "status-ok" : "status-err"}`;
		head.textContent = `${ok ? "✓" : "✗"} ${headline}`;
		el.appendChild(head);
		const order = { error: 0, warn: 1, info: 2 };
		for (const item of [...items].sort((a, b) => order[a.severity] - order[b.severity])) {
			const row = document.createElement("div");
			row.className = `finding finding-${item.severity}`;
			const badge = document.createElement("span");
			badge.className = "finding-badge";
			badge.textContent = item.severity;
			const label = document.createElement("code");
			label.textContent = item.label;
			const message = document.createElement("span");
			message.className = "finding-message";
			message.textContent = item.message;
			row.append(badge, label, message);
			if (item.hint) row.title = item.hint;
			el.appendChild(row);
		}
	}

	function countLine(items) {
		const counts = { error: 0, warn: 0, info: 0 };
		for (const item of items) counts[item.severity]++;
		return `${counts.error} error(s), ${counts.warn} warning(s), ${counts.info} note(s)`;
	}

	async function refreshHost(text) {
		const run = ++hostRun;
		const panel = $("fwb-manifest-findings");
		let manifest;
		try {
			manifest = JSON.parse(text);
		} catch (err) {
			renderFindings(panel, "Invalid JSON", false, [{ severity: "error", label: "json", message: err.message }]);
			return;
		}
		if (!isObject(manifest)) {
			renderFindings(panel, "Not a manifest", false, [{ severity: "error", label: "/", message: "a manifest is a JSON object" }]);
			return;
		}

		const schema = await validateManifestForVersion(manifest, { kind: "app" });
		if (run !== hostRun) return;
		const lint = lintManifests(manifest, []);
		hostLintKeys = new Set(lint.findings.map(findingKey));
		const items = [...schemaItems(schema), ...lintItems(lint.findings.filter((f) => f.code !== "dead-slot"))];
		const version = schema.target ? ` against ${describeTargetVersion(schema.target)}` : "";
		renderFindings(
			panel,
			schema.valid ? `Valid manifest${version}; ${countLine(items)}` : `Schema errors${version}; ${countLine(items)}`,
			schema.valid && !items.some((i) => i.severity === "error"),
			items,
		);

		if (!Array.isArray(manifest.slots)) {
			host = null;
			return;
		}
		applyHost(manifest);
		await refreshMod();
	}

	function applyHost(manifest) {
		host = manifest;
		const shape = JSON.stringify([manifest.slots, manifest.bindings, manifest.types]);
		if (shape === hostShape) {
			renderSlotContracts();
			return;
		}
		hostShape = shape;
		const fresh = sampleHostData(manifest);
		for (const leaf of dataLeaves(hostData)) {
			const next = readPath(fresh, leaf.path);
			if (next !== undefined && expressionType(next) === expressionType(leaf.value)) writePath(fresh, leaf.path, leaf.value);
		}
		hostData = fresh;
		catalog = bindingCatalog(hostData);
		mounted = [];
		renderSlotRegions();
		renderStateControls();
		renderSlotContracts();
	}

	function slotElementId(slotId) {
		return `fwb-slot-${slotId.replace(/[^a-z0-9-]/g, "-")}`;
	}

	function validSlots() {
		return (host?.slots ?? []).filter((slot) => isObject(slot) && typeof slot.id === "string" && Array.isArray(slot.accepts));
	}

	function renderSlotRegions() {
		const container = $("fwb-host-slots");
		const slotSelect = $("fwb-slot-select");
		const previous = slotSelect.value;
		container.replaceChildren();
		slotSelect.replaceChildren();
		for (const slot of validSlots()) {
			const region = document.createElement("div");
			region.className = "slot-region";
			const label = document.createElement("div");
			label.className = "slot-label";
			label.textContent = slot.id;
			const meta = document.createElement("span");
			meta.className = "slot-meta";
			meta.textContent = [slot.multiple ? "multiple" : "single", slot.style || "inherit", slot.capability].filter(Boolean).join(" · ");
			label.appendChild(meta);
			const content = document.createElement("div");
			content.className = "slot-content";
			content.id = slotElementId(slot.id);
			region.append(label, content);
			region.addEventListener("click", () => renderSlotContracts(slot));
			container.appendChild(region);

			const option = document.createElement("option");
			option.value = slot.id;
			option.textContent = slot.id;
			slotSelect.appendChild(option);
		}
		if ([...slotSelect.options].some((o) => o.value === previous)) slotSelect.value = previous;
	}

	function renderSlotContracts(slot) {
		const chosen = slot ?? validSlots().find((s) => s.id === $("fwb-slot-select").value) ?? validSlots()[0];
		for (const id of ["fwb-slot-contract", "fwb-slot-contract-preview"]) {
			const panel = $(id);
			panel.replaceChildren();
			if (!chosen) {
				panel.innerHTML = '<div class="placeholder">This manifest declares no slots.</div>';
				continue;
			}
			const header = document.createElement("div");
			header.className = "contract-header";
			header.textContent = chosen.id;
			panel.appendChild(header);
			const rows = [
				["Description", chosen.description],
				["Accepts", chosen.accepts.join(", ")],
				["Multiple", chosen.multiple ? "yes" : "no"],
				["Style", chosen.style || "inherit"],
				["Capability", chosen.capability],
			];
			for (const [name, value] of rows) {
				if (value === undefined) continue;
				const row = document.createElement("div");
				row.className = "contract-row";
				const label = document.createElement("span");
				label.className = "contract-label";
				label.textContent = `${name}: `;
				row.append(label, String(value));
				panel.appendChild(row);
			}
			if (catalog.length > 0) {
				const row = document.createElement("div");
				row.className = "contract-row";
				row.innerHTML = '<span class="contract-label">Bindable host data:</span>';
				const list = document.createElement("div");
				list.className = "binding-list";
				for (const binding of catalog) {
					const tag = document.createElement("span");
					tag.className = "binding-tag";
					tag.title = binding.path;
					const name = document.createElement("code");
					name.textContent = binding.name;
					const type = document.createElement("span");
					type.className = "binding-type";
					type.textContent = ` ${expressionType(readPath(hostData, binding.path))}`;
					tag.append(name, type);
					list.appendChild(tag);
				}
				panel.append(row, list);
			}
		}
	}

	function renderStateControls() {
		const container = $("fwb-state-controls");
		container.replaceChildren();
		const leaves = dataLeaves(hostData);
		if (leaves.length === 0) {
			container.innerHTML = '<div class="placeholder">This manifest exposes no readable host data.</div>';
			return;
		}
		for (const { path, value } of leaves) {
			const row = document.createElement("div");
			row.className = "control-row";
			const label = document.createElement("label");
			label.textContent = path;
			row.appendChild(label);
			const set = (next) => {
				writePath(hostData, path, next);
				renderFragments();
			};

			if (typeof value === "number") {
				const input = document.createElement("input");
				input.type = "range";
				input.min = "0";
				input.max = "100";
				input.value = String(value);
				const shown = document.createElement("span");
				shown.className = "control-value";
				shown.textContent = String(value);
				input.addEventListener("input", () => {
					shown.textContent = input.value;
					set(Number(input.value));
				});
				row.append(input, shown);
			} else if (typeof value === "boolean") {
				const input = document.createElement("input");
				input.type = "checkbox";
				input.checked = value;
				input.addEventListener("change", () => set(input.checked));
				row.appendChild(input);
			} else if (Array.isArray(value) && value.every((v) => typeof v === "string")) {
				const input = document.createElement("input");
				input.type = "text";
				input.value = value.join(", ");
				input.title = "Comma-separated list";
				input.addEventListener("input", () => set(input.value.split(",").map((p) => p.trim()).filter((p) => p !== "")));
				row.appendChild(input);
			} else if (Array.isArray(value) || isObject(value)) {
				const input = document.createElement("textarea");
				input.rows = 3;
				input.value = JSON.stringify(value);
				input.title = "JSON";
				input.addEventListener("input", () => {
					try {
						set(JSON.parse(input.value));
						input.classList.remove("invalid");
					} catch {
						input.classList.add("invalid");
					}
				});
				row.appendChild(input);
			} else {
				const input = document.createElement("input");
				input.type = "text";
				input.value = String(value ?? "");
				input.addEventListener("input", () => set(input.value));
				row.appendChild(input);
			}
			container.appendChild(row);
		}
	}

	function renderSamples() {
		const select = $("fwb-sample-select");
		select.innerHTML = '<option value="">Sample...</option>';
		for (const [i, sample] of (EXAMPLES[currentExample]?.samples ?? []).entries()) {
			const option = document.createElement("option");
			option.value = String(i);
			option.textContent = sample.name;
			select.appendChild(option);
		}
	}

	function renderFragments() {
		for (const fragment of mounted) fragment.live.render(fragment.container, hostData);
	}

	function currentFormat() {
		return $("fwb-format-toggle").value === "j5ml" ? J5ML : HTML;
	}

	function authoredPackage(inline) {
		const source = editorJar.toString();
		const format = currentFormat();
		const read = new Set(fragmentReadNames(source, format, {
			interpolate: source.includes("{{"),
			formats: host?.formats ?? null,
			vocabularies: host?.vocabularies ?? null,
		}));
		return buildModPackage({
			host,
			slotId: $("fwb-slot-select").value,
			format,
			source,
			modName: $("fwb-mod-name").value.trim(),
			fillId: $("fwb-fill-id").value.trim(),
			inline,
			bindings: catalog.filter((binding) => read.has(binding.name)),
		});
	}

	async function refreshMod() {
		const run = ++modRun;
		const modPanel = $("fwb-mod-findings");
		const exportStatus = $("fwb-export-status");
		const preview = $("fwb-export-preview");
		const fragmentPreview = $("fwb-fragment-preview");
		if (!host || !editorJar.toString().trim() || !$("fwb-slot-select").value) {
			modPanel.replaceChildren();
			exportStatus.replaceChildren();
			preview.innerHTML = '<span class="placeholder">Author a fragment and select a slot to see your mod manifest here.</span>';
			fragmentPreview.textContent = "";
			lastCross = null;
			return;
		}

		const inlinePackage = authoredPackage(true);
		const exported = authoredPackage($("fwb-inline").checked);
		const fillId = $("fwb-fill-id").value.trim();
		const bindingTypes = {
			[fillId]: Object.fromEntries(catalog.map((b) => [b.name, expressionType(readPath(hostData, b.path))])),
		};

		const [schema, cross] = await Promise.all([
			validateManifestForVersion(exported.manifest, { kind: "mod" }),
			crossValidate(host, inlinePackage.manifest),
		]);
		if (run !== modRun) return;
		const lint = lintManifests(host, [inlinePackage.manifest], { bindingTypes });
		const modLint = lint.findings.filter((f) => f.code !== "dead-slot" && !hostLintKeys.has(findingKey(f)));
		lastCross = cross;

		const crossItems = schemaItems(cross).map((item) => ({ ...item, label: item.hint, hint: item.label }));
		const authorItems = [...crossItems, ...lintItems(modLint)];
		const authorOk = cross.valid && !authorItems.some((i) => i.severity === "error");
		renderFindings(modPanel, `${authorOk ? "Fits" : "Does not fit"} ${host.name ?? "the host"}; ${countLine(authorItems)}`, authorOk, authorItems);

		const exportItems = [...schemaItems(schema), ...authorItems];
		const exportOk = schema.valid && authorOk;
		renderFindings(
			exportStatus,
			exportOk ? "mod-manifest.json validates and cross-validates against the app manifest" : `mod-manifest.json has problems; ${countLine(exportItems)}`,
			exportOk,
			exportOk ? exportItems.filter((i) => i.severity !== "info") : exportItems,
		);

		preview.textContent = JSON.stringify(exported.manifest, null, "\t");
		const inline = $("fwb-inline").checked;
		$("fwb-fragment-path").textContent = inline ? "Fragment (inlined in the manifest)" : exported.fragmentPath;
		fragmentPreview.textContent = inline ? "" : editorJar.toString();
		$("fwb-copy-fragment-btn").disabled = inline;
	}

	let modDebounce;
	function scheduleModRefresh() {
		clearTimeout(modDebounce);
		modDebounce = setTimeout(() => refreshMod(), 300);
	}

	function mountFragment() {
		const source = editorJar.toString().trim();
		if (!source || !host) return;
		const slotId = $("fwb-slot-select").value;
		const slot = validSlots().find((s) => s.id === slotId);
		if (!slot) {
			addConsole(`Slot '${slotId}' not found`, "error");
			return;
		}
		const format = currentFormat();
		if (!slot.accepts.includes(format)) {
			addConsole(`Slot '${slotId}' does not accept ${format} (accepts ${slot.accepts.join(", ")})`, "error");
			return;
		}
		if (slot.capability) addConsole(`Slot requires capability: ${slot.capability}`, "log");

		const fill = authoredPackage(true).manifest.fills[slotId][0];
		let live;
		try {
			live = createLiveFragment(source, format, fill.bindings ?? [], fill.interpolate === true, {
				formats: host.formats ?? null,
				vocabularies: host.vocabularies ?? null,
			});
		} catch (err) {
			addConsole(err.message, "error");
			return;
		}

		const stripped = (lastCross?.warnings ?? []).filter((w) => w.keyword === "cross-fill-vocabulary");
		for (const warning of stripped) addConsole(`sanitizer: ${warning.message}`, "error");
		if (stripped.length === 0) addConsole("Fragment is clean", "log");

		const slotEl = $(slotElementId(slotId));
		if (!slotEl) return;
		if (!slot.multiple) {
			slotEl.replaceChildren();
			mounted = mounted.filter((m) => m.slotId !== slotId);
		}
		const wrapper = document.createElement("div");
		wrapper.className = "fragment-wrapper";
		slotEl.appendChild(wrapper);
		live.render(wrapper, hostData);
		mounted.push({ container: wrapper, slotId, live });
		addConsole(`Mounted into ${slotId}`, "result");
	}

	function attributes(props) {
		return `{${Object.entries(props).map(([k, v]) => `${JSON.stringify(k)}: ${JSON.stringify(v)}`).join(", ")}}`;
	}

	function formatJ5ml(node, depth = 0) {
		if (!Array.isArray(node)) return JSON.stringify(node);
		const [name, ...rest] = node;
		const head = [JSON.stringify(name)];
		let children = rest;
		if (isObject(rest[0])) {
			head.push(attributes(rest[0]));
			children = rest.slice(1);
		}
		if (children.every((child) => typeof child === "string")) {
			return `[${[...head, ...children.map((c) => JSON.stringify(c))].join(", ")}]`;
		}
		const indent = "\t".repeat(depth + 1);
		const body = children.map((child) => `${indent}${formatJ5ml(child, depth + 1)}`).join(",\n");
		return `[${head.join(", ")},\n${body}\n${"\t".repeat(depth)}]`;
	}

	function dropLayoutWhitespace(nodes) {
		return nodes
			.filter((node) => !(typeof node === "string" && node.trim() === "" && node.includes("\n")))
			.map((node) => (Array.isArray(node) ? [node[0], ...dropLayoutWhitespace(node.slice(1))] : node));
	}

	function htmlToJ5mlSource(html) {
		const nodes = dropLayoutWhitespace(treeToJsml(htmlToTree(html)));
		return nodes.length === 1 ? formatJ5ml(nodes[0]) : `[\n${nodes.map((n) => `\t${formatJ5ml(n, 1)}`).join(",\n")}\n]`;
	}

	function j5mlToHtmlSource(source) {
		return treeToHtml(jsmlToTree(parseJsmlSource(source, J5ML)));
	}

	function loadExample(key) {
		currentExample = key;
		const manifest = key === "custom" ? CUSTOM_MANIFEST : EXAMPLES[key]?.manifest;
		if (!manifest) return;
		suppressManifestUpdate = true;
		manifestJar.updateCode(JSON.stringify(manifest, null, "\t"));
		suppressManifestUpdate = false;
		renderSamples();
		refreshHost(manifestJar.toString());
	}

	function switchTab(tabId) {
		for (const btn of document.querySelectorAll("#fwb-tabs .tab")) btn.classList.toggle("active", btn.dataset.tab === tabId);
		for (const content of document.querySelectorAll("#fwb .tab-content")) content.classList.toggle("active", content.id === `tab-${tabId}`);
	}

	async function copyText(text, button) {
		try {
			await navigator.clipboard.writeText(text);
			const label = button.textContent;
			button.textContent = "Copied";
			setTimeout(() => (button.textContent = label), 1200);
		} catch (err) {
			addConsole(`Copy failed: ${err.message}`, "error");
		}
	}

	function downloadZip() {
		if (!host || !editorJar.toString().trim()) return;
		const inline = $("fwb-inline").checked;
		const pkg = authoredPackage(inline);
		const entries = [{ path: "mod-manifest.json", content: `${JSON.stringify(pkg.manifest, null, "\t")}\n` }];
		if (!inline) entries.push({ path: pkg.fragmentPath, content: editorJar.toString() });
		const blob = new Blob([createZip(entries)], { type: "application/zip" });
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = `${pkg.manifest.name || "mod"}.zip`;
		a.click();
		setTimeout(() => URL.revokeObjectURL(url), 0);
		addConsole(`Exported ${a.download}`, "result");
	}

	function boot() {
		try {
			$("fwb-loading").style.display = "none";
			$("fwb-main").style.display = "block";

			for (const btn of document.querySelectorAll("#fwb-tabs .tab")) btn.addEventListener("click", () => switchTab(btn.dataset.tab));
			for (const toggle of document.querySelectorAll("#fwb .guide-toggle")) {
				toggle.addEventListener("click", () => {
					const body = toggle.nextElementSibling;
					const open = body.style.display === "none";
					body.style.display = open ? "block" : "none";
					toggle.querySelector(".guide-arrow").textContent = open ? "▾" : "▸";
				});
			}

			const sampleSelect = $("fwb-sample-select");
			const formatToggle = $("fwb-format-toggle");
			const editorEl = $("fwb-editor");

			manifestJar = CodeJar($("fwb-manifest-editor"), highlightJSON, { tab: "\t" });
			editorJar = CodeJar(editorEl, highlightMarkup, { tab: "\t" });

			let manifestDebounce;
			manifestJar.onUpdate((code) => {
				if (suppressManifestUpdate) return;
				clearTimeout(manifestDebounce);
				manifestDebounce = setTimeout(() => refreshHost(code), 400);
			});
			$("fwb-manifest-select").addEventListener("change", (event) => loadExample(event.target.value));

			const wireEditor = () => editorJar.onUpdate(scheduleModRefresh);
			const setEditor = (code) => {
				editorJar.updateCode(code);
				scheduleModRefresh();
			};

			sampleSelect.addEventListener("change", () => {
				const sample = EXAMPLES[currentExample]?.samples[parseInt(sampleSelect.value)];
				if (!sample) return;
				if (formatToggle.value === "j5ml") setEditor(sample.j5ml ?? htmlToJ5mlSource(sample.html));
				else setEditor(sample.html);
			});

			formatToggle.addEventListener("change", () => {
				const code = editorJar.toString();
				const sample = EXAMPLES[currentExample]?.samples[parseInt(sampleSelect.value)];
				let converted = code;
				try {
					if (formatToggle.value === "j5ml") converted = sample?.html === code && sample.j5ml ? sample.j5ml : code.trim() ? htmlToJ5mlSource(code) : "";
					else converted = sample?.j5ml === code ? sample.html : code.trim() ? j5mlToHtmlSource(code) : "";
				} catch (err) {
					addConsole(`Could not convert the source: ${err.message}`, "error");
				}
				editorJar.destroy();
				editorJar = CodeJar(editorEl, formatToggle.value === "j5ml" ? highlightJSON : highlightMarkup, { tab: "\t" });
				wireEditor();
				setEditor(converted);
			});
			wireEditor();

			$("fwb-slot-select").addEventListener("change", () => {
				renderSlotContracts();
				scheduleModRefresh();
			});
			for (const id of ["fwb-mod-name", "fwb-fill-id"]) $(id).addEventListener("input", scheduleModRefresh);
			$("fwb-inline").addEventListener("change", scheduleModRefresh);

			$("fwb-mount-btn").addEventListener("click", mountFragment);
			$("fwb-clear-slots-btn").addEventListener("click", () => {
				for (const el of document.querySelectorAll("#fwb-host-slots .slot-content")) el.replaceChildren();
				mounted = [];
				addConsole("Cleared all slots", "log");
			});
			$("fwb-clear-btn").addEventListener("click", () => {
				$("fwb-console").innerHTML = '<div class="placeholder">Mount a fragment to see output here.</div>';
			});
			$("fwb-export-btn").addEventListener("click", downloadZip);
			$("fwb-copy-manifest-btn").addEventListener("click", (event) => copyText($("fwb-export-preview").textContent, event.currentTarget));
			$("fwb-copy-fragment-btn").addEventListener("click", (event) => copyText(editorJar.toString(), event.currentTarget));

			loadExample("dashboard");
			addConsole("Fragment Workbench ready", "log");
		} catch (err) {
			$("fwb-loading").innerHTML = `<p style="color: #f87171;">Failed to load: ${escapeMarkup(String(err && err.message || err))}</p>`;
		}
	}

	boot();
</script>

